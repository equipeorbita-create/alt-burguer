rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Funções auxiliares ----------
    function logado() {
      return request.auth != null;
    }
    function meuPerfil() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }
    function existePerfil() {
      return exists(/databases/$(database)/documents/usuarios/$(request.auth.uid));
    }
    function ativo() {
      return logado() && existePerfil() && meuPerfil().ativo == true;
    }
    function ehAdmin() {
      return ativo() && meuPerfil().papel == 'admin';
    }
    function ehGerente() {
      return ativo() && meuPerfil().papel == 'gerente';
    }
    function papelValido(p) {
      return p in ['admin', 'gerente', 'funcionario'];
    }

    function lancPath(id) {
      return /databases/$(database)/documents/lancamentos/$(id);
    }
    function reembPath(id) {
      return /databases/$(database)/documents/reembolsos/$(id);
    }

    function ehOperacional() {
      return ativo() && meuPerfil().papel in ['admin', 'gerente'];
    }
    // quem pode conferir o que chegou nas compras: sócios, gerente e funcionários marcados como "conferente"
    function podeConferir() {
      return ativo() && (meuPerfil().papel in ['admin', 'gerente'] || meuPerfil().get('conferente', false) == true);
    }
    function tarefaValida() {
      let d = request.resource.data;
      return d.titulo is string && d.titulo.size() > 0 && d.titulo.size() <= 200
        && d.status in ['a_fazer', 'andamento', 'concluido']
        && d.tipo in ['tarefa', 'melhoria']
        && d.checklist is list && d.checklist.size() <= 50
        && d.responsaveis is list && d.responsaveis.size() <= 20;
    }
    function minhaTarefa() {
      return request.auth.uid in resource.data.get('responsaveis', []);
    }
    // quem não é sócio só mexe no andamento: status e marcação das etapas (sem criar nem apagar etapas)
    function andamentoApenas() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'checklist', 'atualizadoEm'])
        && request.resource.data.status in ['a_fazer', 'andamento', 'concluido']
        && request.resource.data.checklist is list
        && request.resource.data.checklist.size() == resource.data.checklist.size();
    }
    function insumoValido() {
      let d = request.resource.data;
      return d.nome is string && d.nome.size() > 0 && d.nome.size() <= 120
        && d.unidade in ['g', 'ml', 'un']
        && d.qtdEmbalagem is number && d.qtdEmbalagem > 0
        && d.estoqueMinimo is number && d.estoqueMinimo >= 0
        && d.qr is string && d.ativo is bool
        && d.get('eans', []) is list && d.get('eans', []).size() <= 5;
    }

    function receitaValida() {
      let d = request.resource.data;
      return d.nome is string && d.nome.size() > 0 && d.nome.size() <= 120
        && d.tipo in ['preparo', 'prato']
        && d.unidade in ['g', 'ml', 'un']
        && d.rendimento is number && d.rendimento > 0
        && d.ingredientes is list && d.ingredientes.size() <= 40
        && d.pop is map
        && d.ativo is bool;
    }

    function registroPath(uid, rid) {
      return /databases/$(database)/documents/ponto/$(uid)/registros/$(rid);
    }
    function ajustePath(id) {
      return /databases/$(database)/documents/ajustes_ponto/$(id);
    }
    function comunicadoValido() {
      let d = request.resource.data;
      return d.tipo in ['alerta', 'noticia']
        && d.titulo is string && d.titulo.size() > 0 && d.titulo.size() <= 120
        && d.texto is string && d.texto.size() <= 2000
        && d.ativo is bool
        && d.cientes is list && d.cientes.size() <= 100
        && (d.tipo != 'alerta' || d.nivel in ['urgente', 'aviso']);
    }
    // qualquer pessoa pode apenas ADICIONAR o próprio nome à lista de "cientes"
    function cienteApenas() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['cientes'])
        && request.resource.data.cientes.hasAll(resource.data.cientes)
        && request.resource.data.cientes.size() == resource.data.cientes.size() + 1
        && request.auth.uid in request.resource.data.cientes;
    }

    // ---------- Usuários ----------
    // O primeiro sócio é criado manualmente no console (veja o README).
    match /usuarios/{uid} {
      // Cada pessoa lê o próprio perfil; sócios leem todos.
      allow read: if logado() && (request.auth.uid == uid || ehAdmin());
      allow read: if ehGerente() && resource.data.papel == 'funcionario';

      allow create: if ehAdmin()
        && papelValido(request.resource.data.papel)
        && request.resource.data.ativo is bool;

      // Sócio edita os outros, mas não pode se desativar nem tirar o próprio acesso de sócio.
      allow update: if ehAdmin()
        && papelValido(request.resource.data.papel)
        && request.resource.data.ativo is bool
        && (request.auth.uid != uid
            || (request.resource.data.papel == 'admin' && request.resource.data.ativo == true));

      allow delete: if false;
    }

    // ---------- Configurações gerais (divisão 50/50, meta de CMV etc.) ----------
    match /config/{id} {
      allow read: if ativo();
      allow write: if ehAdmin();
    }

    // ---------- Histórico de alterações: só inclusão, só sócios leem ----------
    match /auditoria/{id} {
      allow read: if ehAdmin();
      allow create: if ativo()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.em == request.time;
      allow update, delete: if false;
    }

    // ---------- Tarefas: cada pessoa lê só as suas; sócios leem, criam e apagam todas ----------
    match /tarefas/{id} {
      allow read: if ehAdmin() || (ativo() && minhaTarefa());
      allow create: if ehAdmin() && tarefaValida();
      allow update: if (ehAdmin() && tarefaValida()) || (ativo() && minhaTarefa() && andamentoApenas());
      allow delete: if ehAdmin();
    }

    // ---------- Fase 2: fornecedores e orçamentos (só sócios) ----------
    match /fornecedores/{id} {
      allow read: if ehAdmin();
      allow create, update: if ehAdmin()
        && request.resource.data.nome is string
        && request.resource.data.nome.size() > 0
        && request.resource.data.nome.size() <= 120;
      allow delete: if ehAdmin();
    }
    match /orcamentos/{id} {
      allow read: if ehAdmin();
      allow create, update: if ehAdmin()
        && request.resource.data.item is string
        && request.resource.data.item.size() > 0
        && request.resource.data.fornecedorId is string
        && request.resource.data.valor is number
        && request.resource.data.valor > 0
        && request.resource.data.escolhido is bool;
      allow delete: if ehAdmin();
    }

    // ---------- Fase 3: inventário e patrimônio (só sócios) ----------
    match /patrimonio/{id} {
      allow read: if ehAdmin();
      allow create, update: if ehAdmin()
        && request.resource.data.nome is string
        && request.resource.data.nome.size() > 0
        && request.resource.data.nome.size() <= 120
        && request.resource.data.quantidade is number
        && request.resource.data.quantidade >= 1
        && request.resource.data.quantidade <= 10000
        && request.resource.data.estado in ['bom', 'regular', 'ruim']
        && request.resource.data.situacao in ['em_uso', 'guardado', 'manutencao', 'baixado']
        && request.resource.data.valorMercado is number
        && request.resource.data.valorMercado >= 0
        && request.resource.data.valorAtribuido is number
        && request.resource.data.valorAtribuido >= 0
        && (request.resource.data.get('valorAquisicao', null) == null
            || request.resource.data.valorAquisicao is number)
        && request.resource.data.fotos is list
        && request.resource.data.fotos.size() <= 10
        && request.resource.data.historico is list
        && request.resource.data.historico.size() <= 200;
      allow delete: if ehAdmin();
    }

    // ---------- Fase 4: financeiro e societário (só sócios) ----------
    match /categorias_fin/{id} {
      allow read: if ehAdmin();
      allow create, update: if ehAdmin()
        && request.resource.data.nome is string
        && request.resource.data.nome.size() > 0
        && request.resource.data.nome.size() <= 60
        && request.resource.data.tipo in ['despesa', 'entrada', 'retirada'];
      allow delete: if ehAdmin();
    }

    match /lancamentos/{id} {
      allow read: if ehAdmin();

      allow create: if ehAdmin()
        && request.resource.data.tipo in ['despesa', 'entrada', 'retirada', 'emprestimo', 'reembolso']
        && request.resource.data.valor is number
        && request.resource.data.valor > 0
        && request.resource.data.data is string
        && request.resource.data.data.size() == 10
        && request.resource.data.descricao is string
        && request.resource.data.descricao.size() > 0
        && request.resource.data.descricao.size() <= 200
        && request.resource.data.criadoPor == request.auth.uid
        // empréstimo e retirada precisam ter um sócio
        && (!(request.resource.data.tipo in ['emprestimo', 'retirada', 'reembolso'])
            || request.resource.data.socioId is string && request.resource.data.socioId.size() > 0)
        // reembolso só nasce junto com o pagamento de uma solicitação aprovada pelos dois
        && (request.resource.data.tipo != 'reembolso' || (
              request.resource.data.reembolsoId is string
              && id == 'reemb_' + request.resource.data.reembolsoId
              && get(reembPath(request.resource.data.reembolsoId)).data.status == 'aprovado'
              && get(reembPath(request.resource.data.reembolsoId)).data.aprovacoes.size() >= 2
              && getAfter(reembPath(request.resource.data.reembolsoId)).data.status == 'pago'
              && get(reembPath(request.resource.data.reembolsoId)).data.valor == request.resource.data.valor
              && get(reembPath(request.resource.data.reembolsoId)).data.socioId == request.resource.data.socioId));

      // valor, tipo, data e sócio não mudam; só texto de apoio
      allow update: if ehAdmin()
        && resource.data.tipo != 'reembolso'
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['descricao', 'categoria', 'obs', 'comprovante', 'canal', 'atualizadoEm'])
        && request.resource.data.descricao.size() > 0
        && request.resource.data.descricao.size() <= 200;

      allow delete: if ehAdmin() && resource.data.tipo != 'reembolso';
    }

    match /reembolsos/{id} {
      allow read: if ehAdmin();

      // a solicitação já nasce com a aprovação de quem pediu (e só dela)
      allow create: if ehAdmin()
        && request.resource.data.status == 'pendente'
        && request.resource.data.valor is number
        && request.resource.data.valor > 0
        && request.resource.data.socioId is string
        && request.resource.data.motivo is string
        && request.resource.data.motivo.size() <= 200
        && request.resource.data.solicitadoPor == request.auth.uid
        && request.resource.data.aprovacoes is map
        && request.resource.data.aprovacoes.keys().hasOnly([request.auth.uid]);

      allow update: if ehAdmin() && (
        // 1) aprovar: cada sócio só adiciona a PRÓPRIA aprovação, uma única vez
        ( resource.data.status == 'pendente'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['aprovacoes', 'status'])
          && request.resource.data.aprovacoes.diff(resource.data.aprovacoes).affectedKeys().hasOnly([request.auth.uid])
          && !(request.auth.uid in resource.data.aprovacoes.keys())
          && request.resource.data.aprovacoes[request.auth.uid] == true
          && ((request.resource.data.status == 'aprovado') == (request.resource.data.aprovacoes.size() >= 2)) )
        // 2) recusar
        || ( resource.data.status in ['pendente', 'aprovado']
          && request.resource.data.status == 'recusado'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'recusadoPor'])
          && request.resource.data.recusadoPor == request.auth.uid )
        // 3) pagar: só com 2 aprovações e junto com o lançamento do reembolso
        || ( resource.data.status == 'aprovado'
          && resource.data.aprovacoes.size() >= 2
          && request.resource.data.status == 'pago'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'pagoEm', 'pagoPor'])
          && request.resource.data.pagoPor == request.auth.uid
          && existsAfter(lancPath('reemb_' + id))
          && getAfter(lancPath('reemb_' + id)).data.tipo == 'reembolso'
          && getAfter(lancPath('reemb_' + id)).data.valor == resource.data.valor
          && getAfter(lancPath('reemb_' + id)).data.socioId == resource.data.socioId )
      );

      allow delete: if false;
    }

    // ---------- Fase 5: estoque ----------
    // Insumos: todos os perfis leem (sem preços); só sócios cadastram. Nunca apagam (desativam).
    match /insumos/{id} {
      allow read: if ativo();
      allow create: if ehAdmin() && insumoValido();
      allow update: if ehAdmin() && insumoValido()
        && request.resource.data.unidade == resource.data.unidade
        && request.resource.data.qr == resource.data.qr;
      allow delete: if false;
    }

    // Preços e custos: SÓ sócios (gerente e funcionário nunca veem)
    match /insumos_custos/{id} {
      allow read: if ehAdmin();
      allow create, update: if ehAdmin()
        && request.resource.data.precoEmbalagem is number
        && request.resource.data.precoEmbalagem >= 0
        && request.resource.data.custoUnitario is number
        && request.resource.data.custoUnitario >= 0;
      allow delete: if false;

      match /historico/{hid} {
        allow read: if ehAdmin();
        allow create: if ehAdmin() && request.resource.data.precoEmbalagem is number;
        allow update, delete: if false;
      }
    }

    // Lotes: sócios e gerente criam (compra e ajuste). Qualquer perfil pode apenas DIMINUIR o saldo (baixa).
    match /lotes/{id} {
      allow read: if ativo();
      allow create: if ehOperacional()
        && request.resource.data.insumoId is string
        && request.resource.data.qtdInicial is number
        && request.resource.data.qtdInicial > 0
        && request.resource.data.qtdAtual == request.resource.data.qtdInicial
        && request.resource.data.criadoPor == request.auth.uid;
      allow update: if (ehAdmin()
            && request.resource.data.qtdAtual is number
            && request.resource.data.qtdAtual >= 0)
        || (ativo()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['qtdAtual'])
            && request.resource.data.qtdAtual is number
            && request.resource.data.qtdAtual >= 0
            && request.resource.data.qtdAtual < resource.data.qtdAtual)
        // conferência do que chegou: ajusta a quantidade (só para menos), informa a validade e marca como conferido
        || (podeConferir()
            && resource.data.get('conferido', true) == false
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['qtdAtual', 'validade', 'conferido', 'conferidoPor'])
            && request.resource.data.conferido == true
            && request.resource.data.conferidoPor == request.auth.uid
            && request.resource.data.qtdAtual is number
            && request.resource.data.qtdAtual >= 0
            && request.resource.data.qtdAtual <= resource.data.qtdAtual
            && request.resource.data.validade is string);
      allow delete: if false;
    }

    // Movimentações: histórico que ninguém edita nem apaga. Funcionário só registra saídas.
    match /movimentacoes/{id} {
      allow read: if ehOperacional();
      allow create: if ativo()
        && request.resource.data.por == request.auth.uid
        && request.resource.data.em == request.time
        && request.resource.data.insumoId is string
        && request.resource.data.delta is number
        && request.resource.data.delta != 0
        && ((ehOperacional() && request.resource.data.tipo in ['baixa', 'descarte', 'compra', 'ajuste', 'producao', 'conferencia'])
            || (request.resource.data.tipo in ['baixa', 'descarte', 'conferencia'] && request.resource.data.delta < 0));
      allow update, delete: if false;
    }

    // Compras: só sócios; não se edita nem se apaga (corrige-se por ajuste)
    match /compras/{id} {
      allow read: if ehAdmin();
      allow create: if ehAdmin()
        && request.resource.data.total is number
        && request.resource.data.total > 0
        && request.resource.data.itens is list
        && request.resource.data.itens.size() > 0
        && request.resource.data.itens.size() <= 50
        && request.resource.data.criadoPor == request.auth.uid;
      allow update, delete: if false;
    }

    // ---------- Fase 6: cardápio, fichas técnicas e POPs ----------
    // Fichas (pesagens e passo a passo): todos leem. Sócios e gerente editam. Só sócios excluem.
    match /receitas/{id} {
      allow read: if ativo();
      allow create: if ehOperacional() && receitaValida();
      allow update: if ehOperacional() && receitaValida()
        && request.resource.data.tipo == resource.data.tipo;
      allow delete: if ehAdmin();
    }

    // Preço de venda e meta de CMV: SÓ sócios (o custo também só é calculável por quem lê os preços dos insumos)
    match /receitas_precos/{id} {
      allow read: if ehAdmin();
      allow create, update: if ehAdmin()
        && request.resource.data.precoVenda is number
        && request.resource.data.precoVenda >= 0;
      allow delete: if ehAdmin();
    }

    // ---------- Fase 7: portal, ponto, equipe ----------
    match /comunicados/{id} {
      allow read: if ativo();
      allow create: if ehOperacional() && comunicadoValido();
      allow update: if (ehOperacional() && comunicadoValido()) || (ativo() && cienteApenas());
      allow delete: if ehAdmin();
    }

    match /manual/{id} {
      allow read: if ativo();
      allow create, update: if ehOperacional()
        && request.resource.data.titulo is string && request.resource.data.titulo.size() > 0 && request.resource.data.titulo.size() <= 120
        && request.resource.data.texto is string && request.resource.data.texto.size() <= 5000
        && request.resource.data.ordem is number;
      allow delete: if ehAdmin();
    }

    match /funcionarios/{uid} {
      allow read: if ehOperacional() || (ativo() && request.auth.uid == uid);
      allow create, update: if ehAdmin();
      allow delete: if false;
    }

    // Ponto: cada pessoa registra o PRÓPRIO ponto, sempre com a hora do servidor (não dá para adulterar pelo celular).
    // Ninguém edita nem apaga registros. Esquecimentos entram por ajuste aprovado por outra pessoa.
    match /ponto/{uid}/registros/{id} {
      allow read: if ativo() && (request.auth.uid == uid || ehOperacional());
      allow create: if ativo()
        && request.resource.data.tipo in ['entrada', 'intervalo_inicio', 'intervalo_fim', 'saida']
        && (
          ( request.auth.uid == uid
            && request.resource.data.origem == 'ponto'
            && request.resource.data.em == request.time )
          ||
          ( ehOperacional()
            && request.resource.data.origem == 'ajuste'
            && request.resource.data.ajusteId is string
            && id == 'aj_' + request.resource.data.ajusteId
            && request.resource.data.aprovadoPor == request.auth.uid
            && get(ajustePath(request.resource.data.ajusteId)).data.status == 'pendente'
            && getAfter(ajustePath(request.resource.data.ajusteId)).data.status == 'aprovado'
            && get(ajustePath(request.resource.data.ajusteId)).data.uid == uid
            && get(ajustePath(request.resource.data.ajusteId)).data.uid != request.auth.uid
            && get(ajustePath(request.resource.data.ajusteId)).data.em == request.resource.data.em
            && get(ajustePath(request.resource.data.ajusteId)).data.tipo == request.resource.data.tipo )
        );
      allow update, delete: if false;
    }

    match /ajustes_ponto/{id} {
      allow read: if ativo() && (resource.data.uid == request.auth.uid || ehOperacional());
      allow create: if ativo()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pendente'
        && request.resource.data.tipo in ['entrada', 'intervalo_inicio', 'intervalo_fim', 'saida']
        && request.resource.data.em is timestamp
        && request.resource.data.em <= request.time
        && request.resource.data.justificativa is string
        && request.resource.data.justificativa.size() >= 3
        && request.resource.data.justificativa.size() <= 200;
      // quem aprova nunca é o próprio solicitante; aprovar exige lançar o registro junto
      allow update: if ehOperacional()
        && resource.data.status == 'pendente'
        && resource.data.uid != request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'decididoPor', 'decididoPorNome', 'decididoEm'])
        && request.resource.data.decididoPor == request.auth.uid
        && ( request.resource.data.status == 'recusado'
             || ( request.resource.data.status == 'aprovado'
                  && existsAfter(registroPath(resource.data.uid, 'aj_' + id)) ) );
      allow delete: if false;
    }

    // ---------- Fase 8: recebimento, contagem, rotinas e prejuízos ----------
    // Recebimento = conferência do que chegou numa compra. NÃO tem valores (quem confere não vê preços).
    // Quem fez a compra não pode conferir a própria compra.
    match /recebimentos/{id} {
      allow read: if podeConferir();
      allow create: if ehAdmin()
        && request.resource.data.status == 'pendente'
        && request.resource.data.itens is list
        && request.resource.data.itens.size() > 0
        && request.resource.data.itens.size() <= 50
        && request.resource.data.criadoPor == request.auth.uid;
      allow update: if podeConferir()
        && resource.data.status == 'pendente'
        && resource.data.criadoPor != request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'conferencia'])
        && request.resource.data.status in ['ok', 'divergencia']
        && request.resource.data.conferencia.por == request.auth.uid;
      allow delete: if false;
    }

    // Cada auditoria de estoque fica registrada (com a foto), mesmo quando a contagem confere
    match /contagens/{id} {
      allow read: if ehOperacional();
      allow create: if ehOperacional()
        && request.resource.data.por == request.auth.uid
        && request.resource.data.em == request.time
        && request.resource.data.insumoId is string
        && request.resource.data.contado is number
        && request.resource.data.contado >= 0;
      allow update, delete: if false;
    }

    // Rotinas (checklists do dia e periódicas): só sócios definem; todos executam
    match /rotinas/{id} {
      allow read: if ativo();
      allow create, update: if ehAdmin()
        && request.resource.data.nome is string && request.resource.data.nome.size() > 0 && request.resource.data.nome.size() <= 120
        && request.resource.data.itens is list && request.resource.data.itens.size() > 0 && request.resource.data.itens.size() <= 50
        && request.resource.data.recorrencia is map
        && request.resource.data.ativo is bool;
      allow delete: if ehAdmin();
    }
    match /rotinas_exec/{id} {
      allow read: if ativo();
      allow create, update: if ativo()
        && request.resource.data.rotinaId is string
        && request.resource.data.data is string && request.resource.data.data.size() == 10
        && request.resource.data.itens is list && request.resource.data.itens.size() <= 50
        && request.resource.data.concluida is bool;
      allow delete: if false;
    }

    // Prejuízos: cada pessoa vê os próprios relatos; sócios e gerente veem todos; só o sócio define o valor
    match /prejuizos/{id} {
      allow read: if ativo() && (resource.data.reportadoPor == request.auth.uid || ehOperacional());
      allow create: if ativo()
        && request.resource.data.reportadoPor == request.auth.uid
        && request.resource.data.sem is bool
        && request.resource.data.tipo is string
        && request.resource.data.descricao is string && request.resource.data.descricao.size() <= 300
        && request.resource.data.criadoEm == request.time
        && (!('valor' in request.resource.data) || request.resource.data.valor == null);
      allow update: if ehOperacional()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['valor', 'status', 'vistoPor', 'vistoPorNome'])
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['valor']) || ehAdmin())
        && (!('valor' in request.resource.data) || request.resource.data.valor == null
            || (request.resource.data.valor is number && request.resource.data.valor >= 0));
      allow delete: if false;
    }

    // ---------- Tudo o que não foi liberado acima fica bloqueado ----------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
