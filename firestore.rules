rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Funções auxiliares ----------
    function logado() {
      return request.auth != null;
    }
    function meuPerfil() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }
    function existePerfil() {
      return exists(/databases/$(database)/documents/usuarios/$(request.auth.uid));
    }
    function ativo() {
      return logado() && existePerfil() && meuPerfil().ativo == true;
    }
    function ehAdmin() {
      return ativo() && meuPerfil().papel == 'admin';
    }
    function ehGerente() {
      return ativo() && meuPerfil().papel == 'gerente';
    }
    function papelValido(p) {
      return p in ['admin', 'gerente', 'funcionario'];
    }

    // ---------- Usuários ----------
    // O primeiro sócio é criado manualmente no console (veja o README).
    match /usuarios/{uid} {
      // Cada pessoa lê o próprio perfil; sócios leem todos.
      allow read: if logado() && (request.auth.uid == uid || ehAdmin());

      allow create: if ehAdmin()
        && papelValido(request.resource.data.papel)
        && request.resource.data.ativo is bool;

      // Sócio edita os outros, mas não pode se desativar nem tirar o próprio acesso de sócio.
      allow update: if ehAdmin()
        && papelValido(request.resource.data.papel)
        && request.resource.data.ativo is bool
        && (request.auth.uid != uid
            || (request.resource.data.papel == 'admin' && request.resource.data.ativo == true));

      allow delete: if false;
    }

    // ---------- Configurações gerais (divisão 50/50, meta de CMV etc.) ----------
    match /config/{id} {
      allow read: if ativo();
      allow write: if ehAdmin();
    }

    // ---------- Histórico de alterações: só inclusão, só sócios leem ----------
    match /auditoria/{id} {
      allow read: if ehAdmin();
      allow create: if ativo()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.em == request.time;
      allow update, delete: if false;
    }

    // ---------- Fase 2: tarefas (sócios e gerente) ----------
    match /tarefas/{id} {
      allow read: if ehAdmin() || ehGerente();
      allow create, update: if (ehAdmin() || ehGerente())
        && request.resource.data.titulo is string
        && request.resource.data.titulo.size() > 0
        && request.resource.data.titulo.size() <= 200
        && request.resource.data.status in ['a_fazer', 'andamento', 'concluido']
        && request.resource.data.tipo in ['tarefa', 'melhoria']
        && request.resource.data.checklist is list
        && request.resource.data.checklist.size() <= 50;
      allow delete: if ehAdmin();
    }

    // ---------- Fase 2: fornecedores e orçamentos (só sócios) ----------
    match /fornecedores/{id} {
      allow read: if ehAdmin();
      allow create, update: if ehAdmin()
        && request.resource.data.nome is string
        && request.resource.data.nome.size() > 0
        && request.resource.data.nome.size() <= 120;
      allow delete: if ehAdmin();
    }
    match /orcamentos/{id} {
      allow read: if ehAdmin();
      allow create, update: if ehAdmin()
        && request.resource.data.item is string
        && request.resource.data.item.size() > 0
        && request.resource.data.fornecedorId is string
        && request.resource.data.valor is number
        && request.resource.data.valor > 0
        && request.resource.data.escolhido is bool;
      allow delete: if ehAdmin();
    }

    // ---------- Fase 3: inventário e patrimônio (só sócios) ----------
    match /patrimonio/{id} {
      allow read: if ehAdmin();
      allow create, update: if ehAdmin()
        && request.resource.data.nome is string
        && request.resource.data.nome.size() > 0
        && request.resource.data.nome.size() <= 120
        && request.resource.data.quantidade is number
        && request.resource.data.quantidade >= 1
        && request.resource.data.quantidade <= 10000
        && request.resource.data.estado in ['bom', 'regular', 'ruim']
        && request.resource.data.situacao in ['em_uso', 'guardado', 'manutencao', 'baixado']
        && request.resource.data.valorMercado is number
        && request.resource.data.valorMercado >= 0
        && request.resource.data.valorAtribuido is number
        && request.resource.data.valorAtribuido >= 0
        && (request.resource.data.get('valorAquisicao', null) == null
            || request.resource.data.valorAquisicao is number)
        && request.resource.data.fotos is list
        && request.resource.data.fotos.size() <= 10
        && request.resource.data.historico is list
        && request.resource.data.historico.size() <= 200;
      allow delete: if ehAdmin();
    }

    // ---------- Tudo o que não foi liberado acima fica bloqueado ----------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
